psql -c '\d'

** PAM

cat <<EOF >/etc/pam_pgsql.conf
connect = dbname=userdb user=user1 password=secret91 host=db connect_timeout=15
auth_query = select passwd from usr where name = %u
pw_type = clear
pwd_query = update usr set passwd = %p where user_name = %u
acct_query = select false,false,false ;
EOF

#  acct_query - usr options query (should return 3 or 4 boolean columns -- expired, new password required and password is null, return PAM_PERM_DENIED (y/n)) overrides other usr specific options
# acct_query = select (acc_expired = 'y' OR acc_expired = '1'), (acc_new_pwreq = 'y' OR acc_new_pwreq = '1'), (user_password IS NULL OR user_password = '') from usr where user_name = %u

** test: use login command
cat >/etc/pam.d/login  <<EOF
auth        required    pam_pgsql.so
account     required    pam_pgsql.so
password    required    pam_pgsql.so
session     required    pam_pgsql.so
EOF

** libnss pgsql

cat >/etc/nss-pgsql.conf <<EOF
# See https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING
connectionstring        = hostaddr=10.0.0.4 dbname=sysdb user=user1 password=secret91 sslmode=disable

# Must return           name
getgroupmembersbygid   = SELECT name FROM passwd WHERE gid = $1
# Must return           name, passwd, gecos, homedir, shell, uid, gid
getpwnam       = SELECT name, passwd, gecos, homedir, shell, uid, gid FROM usr WHERE name = $1
# Must return           name, passwd, gecos, homedir, shell, uid, gid
getpwuid       = SELECT name, passwd, gecos, homedir, shell, uid, gid FROM usr WHERE uid = $1
# Must return           name, passwd, gecos, homedir, shell, uid, gid
allusers       = SELECT name, passwd, gecos, homedir, shell, uid, gid FROM usr

# Must return           name, passwd, gid, array of group members
getgrnam       = SELECT name, passwd, gid, ARRAY(SELECT name FROM member m WHERE m.gid = grp.gid) AS members FROM grp WHERE groupname = $1
# Must return           name, passwd, gid
getgrgid       = SELECT name, passwd, gid, ARRAY(SELECT name FROM member m WHERE m.gid = grp.gid) AS members descr   FROM grp WHERE gid = $1
# Must return gid.  %s MUST appear first for name match in where clause
groups_dyn      = SELECT m.gid FROM usr JOIN member m ON (m.uid=usr.uid) where usr.name = $1 and m.gid <> $2
# Must return           name, passwd, gid
allgroups      = SELECT name, passwd, gid  FROM grp
EOF

