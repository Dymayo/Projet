* Installation (server side)

** install packages
apt update
apt install -y sudo host lsof

** install database server
apt install -y postgresql

** create schema (commong schema for pam & nss; schema adapted from libnss-pgsql)
database="sysdb"
dbuser="sysadm"
dbpassword="secret91"
dbhost="dbserv"

# Create user in postgres
sudo -u postgres createuser -d $dbuser
# Set password
sudo -u postgres psql -c "alter user $dbuser password '$dbpassword'"
# Create database
sudo -u postgres createdb --owner=$dbuser $database
# Create schema

cat >schema.sql <<EOF
-- sequences
CREATE SEQUENCE gidseq MINVALUE 1001 MAXVALUE 2147483647 NO CYCLE;
CREATE SEQUENCE uidseq MINVALUE 1001 MAXVALUE 2147483647 NO CYCLE;
-- group
CREATE TABLE grp (
    gid int4 NOT NULL DEFAULT nextval('gidseq'),
    name character varying(16) UNIQUE NOT NULL, -- group name
    descr character varying,
    passwd character varying(20),
    PRIMARY KEY (gid)
);
-- user
CREATE TABLE usr (
    name character varying(64) UNIQUE NOT NULL, -- user login
    passwd character varying(128) NOT NULL,
    uid int4 NOT NULL DEFAULT nextval('uidseq'),
    gid int4 NOT NULL,                -- primary group id
    gecos character varying(128),            -- gecos field
    homedir character varying(256) NOT NULL,
    shell character varying DEFAULT '/bin/bash' NOT NULL,
    PRIMARY KEY (uid)
);
-- shadow
CREATE TABLE shadow (
     name character varying(64) UNIQUE NOT NULL,
     passwd character varying(128) NOT NULL,
     lastchange int4 NOT NULL,
     min int4 NOT NULL,
     max int4 NOT NULL,
     warn int4 NOT NULL,
     inact int4 NOT NULL,
     expire int4 NOT NULL,
     flag int4 NOT NULL,
     PRIMARY KEY (name)
);
-- group member: map user id to group id
CREATE TABLE member (
    gid int4 NOT NULL,
    uid int4 NOT NULL,
    PRIMARY KEY (gid, uid),
    CONSTRAINT gm_gid_fkey FOREIGN KEY (gid) REFERENCES grp(gid),
    CONSTRAINT gm_uid_fkey FOREIGN KEY (uid) REFERENCES usr(uid)
);
EOF

PGUSER=$dbuser PGPASSWORD=$dbpassword PGHOST=localhost psql -d $database -f schema.sql

